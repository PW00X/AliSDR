pkgname=alisdr
pkgver=1.1.1
pkgrel=1
pkgdesc="Wideband SDR radio scanner with manual broadcast tuning"
arch=('any')
url="https://github.com/PW00X/AliSDR"
license=('GPL-3.0-or-later')
depends=('python' 'python-numpy' 'python-scipy' 'hicolor-icon-theme')
makedepends=('git')
optdepends=('soapysdr: hardware access via SoapySDR'
            'soapyrtlsdr: RTL-SDR receivers'
            'ffmpeg: MP3 recording output')
conflicts=('smartscanatc' 'falconsdr')
source=("AliSDR::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

package() {
  cd "$srcdir/AliSDR"
  install -Dm644 main.py "$pkgdir/usr/lib/alisdr/main.py"
  cp -a alisdr "$pkgdir/usr/lib/alisdr/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/alisdr/LICENSE"
  install -Dm644 packaging/linux-deb/alisdr.desktop "$pkgdir/usr/share/applications/alisdr.desktop"
  install -Dm644 packaging/icons/alisdr.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/alisdr.png"
  install -Dm644 packaging/linux-deb/60-rtl-sdr.rules "$pkgdir/usr/lib/udev/rules.d/60-rtl-sdr.rules"
  install -Dm644 packaging/linux-deb/blacklist-rtl-dvb.conf "$pkgdir/usr/lib/modprobe.d/blacklist-rtl-dvb.conf"
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/alisdr" <<'EOF'
#!/bin/sh
exec /usr/bin/python /usr/lib/alisdr/main.py "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/alisdr"
}
